@using System
@using System.Web.Mvc

@{
    ViewBag.Title = "Trang chủ bệnh nhân - eHealthCare";
    Layout = null;

    bool daDangNhap = Request.IsAuthenticated;
    string tenDangNhap = daDangNhap ? User.Identity.Name : "";

    // Nếu chưa đăng nhập, chuyển tới trang đăng nhập.
    // Nếu đã đăng nhập, HoSo tự kiểm tra hồ sơ đã có và chuyển sang BHYT.
    string duongDanBatDau = daDangNhap
        ? Url.Action("HoSo", "BenhNhan")
        : Url.Action("Login", "Account");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <style>
        :root {
            --navy: #123344;
            --teal: #087f8c;
            --light-teal: #e5f6f5;
            --muted: #647788;
            --border: #e4edf0;
            --surface: #ffffff;
            --background: #f5f9fa;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--navy);
            font-family: "Segoe UI", Arial, sans-serif;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
        }

        button {
            font: inherit;
        }

        .wrap {
            width: min(1180px, calc(100% - 40px));
            margin: 0 auto;
        }

        .site-header {
            background: #fff;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 3px 18px rgba(15, 51, 67, .035);
        }

        .nav-row {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            color: var(--navy);
            font-weight: 800;
            font-size: 23px;
            white-space: nowrap;
        }

        .brand-icon {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: #fff;
            background: var(--teal);
            font-size: 27px;
            font-weight: 700;
            line-height: 1;
        }

        .brand span:last-child span {
            color: var(--teal);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

            .nav-links a {
                color: #526b7b;
                font-size: 14px;
                font-weight: 600;
            }

                .nav-links a:hover {
                    color: var(--teal);
                }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .greeting {
            font-size: 13px;
            color: #6b7f8d;
            white-space: nowrap;
        }

            .greeting strong {
                color: var(--navy);
            }

        .logout-form {
            margin: 0;
        }

        .logout-btn {
            padding: 9px 16px;
            background: #fff;
            color: #b33d48;
            border: 1px solid #e8b8be;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

            .logout-btn:hover {
                background: #fff1f1;
            }

        .small-btn {
            padding: 10px 17px;
            border-radius: 10px;
            background: var(--teal);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
        }

            .small-btn:hover {
                background: #076976;
            }

        .hero {
            margin-top: 30px;
            border-radius: 27px;
            overflow: hidden;
            background: linear-gradient(115deg, #104b5e 0%, #07798b 100%);
            color: white;
            position: relative;
            box-shadow: 0 18px 45px rgba(11, 91, 105, .13);
        }

            .hero:before {
                content: "";
                position: absolute;
                width: 460px;
                height: 460px;
                border: 1px solid rgba(255,255,255,.16);
                border-radius: 50%;
                right: -120px;
                top: -190px;
            }

            .hero:after {
                content: "";
                position: absolute;
                width: 350px;
                height: 350px;
                border: 1px solid rgba(255,255,255,.13);
                border-radius: 50%;
                right: 50px;
                bottom: -255px;
            }

        .hero-inner {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: 1.15fr .85fr;
            align-items: center;
            gap: 44px;
            padding: 62px 66px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 13px;
            border-radius: 999px;
            background: rgba(255,255,255,.13);
            color: #e2faf9;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: #a5f1ce;
            border-radius: 50%;
        }

        .hero h1 {
            font-size: clamp(31px, 3.6vw, 49px);
            line-height: 1.17;
            letter-spacing: -.9px;
            margin: 22px 0 17px;
            font-weight: 800;
        }

            .hero h1 em {
                font-style: normal;
                color: #b7f7ea;
            }

        .hero p {
            max-width: 510px;
            font-size: 15px;
            color: #e3f5f6;
            margin: 0;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 28px;
        }

        .primary-btn {
            background: #fff;
            color: #0b6274;
            padding: 14px 22px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 800;
            font-size: 14px;
            box-shadow: 0 5px 13px rgba(0,0,0,.08);
        }

            .primary-btn:hover {
                background: #effdfb;
                transform: translateY(-1px);
            }

        .outline-btn {
            border: 1px solid rgba(255,255,255,.55);
            color: white;
            border-radius: 11px;
            padding: 13px 19px;
            font-size: 14px;
            font-weight: 700;
        }

            .outline-btn:hover {
                background: rgba(255,255,255,.1);
            }

        .hero-note {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-top: 23px;
            color: #cce9ec;
            font-size: 12px;
        }

            .hero-note .tick {
                color: #9ef2ca;
                font-weight: 800;
            }

        .preview-card {
            width: 100%;
            max-width: 365px;
            margin-left: auto;
            background: #fff;
            color: var(--navy);
            border-radius: 19px;
            padding: 23px 26px;
            box-shadow: 0 18px 32px rgba(3, 45, 55, .19);
            transform: rotate(2deg);
        }

        .preview-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            border-bottom: 1px dashed #d9e4e8;
            padding-bottom: 15px;
        }

            .preview-top strong {
                font-size: 14px;
            }

            .preview-top small {
                color: #8a9ca7;
                font-size: 11px;
            }

        .preview-badge {
            display: inline-block;
            font-size: 11px;
            color: #087e78;
            background: #e4f6f2;
            padding: 5px 9px;
            border-radius: 999px;
            white-space: nowrap;
        }

        .preview-center {
            text-align: center;
            padding: 18px 0 15px;
        }

            .preview-center .caption {
                display: block;
                color: #81909c;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                font-size: 10px;
                font-weight: 800;
            }

            .preview-center .number {
                color: var(--teal);
                font-size: 76px;
                line-height: 1.3;
                font-weight: 800;
                letter-spacing: 1px;
            }

            .preview-center .status {
                display: inline-block;
                background: #fff2d8;
                color: #936700;
                border-radius: 999px;
                padding: 5px 14px;
                font-size: 12px;
                font-weight: 700;
            }

        .preview-bottom {
            border-top: 1px dashed #d9e4e8;
            padding-top: 15px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 11px;
            color: #7a8d98;
        }

            .preview-bottom strong {
                color: #274758;
            }

        .preview-hint {
            font-size: 11px;
            color: #708591;
            text-align: center;
            margin-top: 13px;
        }

        .section {
            margin: 64px auto 0;
        }

        .section-kicker {
            color: var(--teal);
            text-transform: uppercase;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.4px;
        }

        .section h2 {
            color: var(--navy);
            font-size: 29px;
            line-height: 1.3;
            margin: 8px 0;
        }

        .section-lead {
            color: var(--muted);
            font-size: 15px;
            margin: 0 0 26px;
        }

        .steps {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .step {
            background: white;
            border: 1px solid var(--border);
            border-radius: 17px;
            padding: 26px 23px;
            min-height: 205px;
            box-shadow: 0 7px 22px rgba(22, 57, 70, .035);
        }

        .step-num {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--light-teal);
            color: var(--teal);
            font-weight: 800;
        }

        .step h3 {
            font-size: 16px;
            margin: 20px 0 8px;
        }

        .step p {
            color: var(--muted);
            margin: 0;
            font-size: 13px;
            line-height: 1.7;
        }

        .features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 25px;
        }

        .feature {
            display: flex;
            gap: 15px;
            padding: 23px;
            border-radius: 15px;
            background: #eaf4f5;
        }

        .feature-icon {
            flex: 0 0 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #d7ebec;
            font-size: 21px;
        }

        .feature h3 {
            font-size: 15px;
            margin: 0 0 5px;
        }

        .feature p {
            color: #607985;
            margin: 0;
            font-size: 12px;
            line-height: 1.65;
        }

        .start-banner {
            margin-top: 55px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 19px;
            padding: 28px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

            .start-banner h2 {
                margin: 0 0 5px;
                font-size: 22px;
            }

            .start-banner p {
                margin: 0;
                color: var(--muted);
                font-size: 13px;
            }

            .start-banner .small-btn {
                padding: 14px 22px;
                white-space: nowrap;
            }

        .site-footer {
            padding: 31px 0 35px;
            color: #8395a0;
            font-size: 12px;
            text-align: center;
        }

        @@media (max-width: 1040px) {
            .nav-links {
                display: none;
            }

            .hero-inner {
                padding: 50px 44px;
                gap: 24px;
            }

            .steps {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 730px) {
            .wrap {
                width: min(100% - 24px, 1180px);
            }

            .nav-row {
                min-height: 71px;
                flex-wrap: wrap;
                padding: 12px 0;
            }

            .brand {
                font-size: 20px;
            }

            .greeting {
                display: none;
            }

            .hero {
                margin-top: 16px;
                border-radius: 19px;
            }

            .hero-inner {
                grid-template-columns: 1fr;
                padding: 37px 25px;
            }

            .preview-card {
                max-width: 345px;
                margin: 12px auto 0;
                transform: none;
            }

            .hero h1 {
                margin-top: 16px;
            }

            .section {
                margin-top: 43px;
            }

            .steps, .features {
                grid-template-columns: 1fr;
            }

            .step {
                min-height: auto;
            }

            .start-banner {
                flex-direction: column;
                align-items: flex-start;
                padding: 24px;
            }

                .start-banner .small-btn {
                    width: 100%;
                    text-align: center;
                }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="wrap nav-row">
            <a class="brand" href="@Url.Action("Index", "Home")" aria-label="eHealthCare - Trang chủ">
                <span class="brand-icon">+</span>
                <span>e<span>Health</span>Care</span>
            </a>

            <nav class="nav-links" aria-label="Điều hướng">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a href="#quy-trinh">Quy trình đăng ký</a>
                <a href="#tien-ich">Tiện ích</a>
            </nav>

            <div class="nav-actions">
                @if (daDangNhap)
                {
                    <span class="greeting">Xin chào, <strong>@tenDangNhap</strong></span>
                    using (Html.BeginForm("DangXuat", "Account", FormMethod.Post,
                        new { @class = "logout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout-btn">Đăng xuất</button>
                    }
                }
                else
                {
                    <a class="small-btn" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                    <a class="logout-btn" href="@Url.Action("Register", "Account")">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <main class="wrap">
        <section class="hero">
            <div class="hero-inner">
                <div>
                    <div class="eyebrow"><span class="status-dot"></span> CỔNG ĐĂNG KÝ KHÁM BỆNH</div>
                    <h1>Chăm sóc sức khỏe <em>thuận tiện hơn</em> mỗi ngày.</h1>
                    <p>Chọn chuyên khoa, xem bác sĩ trong ca trực và nhận số thứ tự khám ngay trên eHealthCare — không cần chọn ngày giờ thủ công.</p>
                    <div class="hero-buttons">
                        <a class="primary-btn" href="@duongDanBatDau">Bắt đầu đăng ký khám <span aria-hidden="true">→</span></a>
                        <a class="outline-btn" href="#quy-trinh">Xem hướng dẫn</a>
                    </div>
                    <div class="hero-note"><span class="tick">✓</span> Theo dõi thông tin đăng ký rõ ràng, dễ sử dụng</div>
                </div>
                <div class="preview-card" aria-label="Phiếu số thứ tự minh họa">
                    <div class="preview-top">
                        <div><strong>PHIẾU KHÁM BỆNH</strong><br /><small>eHealthCare</small></div>
                        <span class="preview-badge">Bản minh họa</span>
                    </div>
                    <div class="preview-center">
                        <span class="caption">Số thứ tự mẫu</span>
                        <div class="number">001</div>
                        <span class="status">Chờ khám</span>
                    </div>
                    <div class="preview-bottom">
                        <span>Đăng ký theo<br /><strong>Ca trực bác sĩ</strong></span>
                        <span>Trạng thái<br /><strong>Chờ đến lượt</strong></span>
                    </div>
                    <div class="preview-hint">Số thật được cấp sau khi đăng ký thành công.</div>
                </div>
            </div>
        </section>

        <section class="section" id="quy-trinh">
            <span class="section-kicker">Đơn giản và nhanh chóng</span>
            <h2>Đăng ký khám chỉ trong 4 bước</h2>
            <p class="section-lead">Mọi bước được thực hiện ngay trên website, theo đúng quy trình khám bệnh.</p>
            <div class="steps">
                <article class="step"><span class="step-num">01</span><h3>Hoàn thiện hồ sơ</h3><p>Đăng nhập và bổ sung thông tin bệnh nhân khi chưa có hồ sơ.</p></article>
                <article class="step"><span class="step-num">02</span><h3>Nhập thông tin BHYT</h3><p>Điền thông tin thẻ bảo hiểm y tế trong biểu mẫu đăng ký.</p></article>
                <article class="step"><span class="step-num">03</span><h3>Chọn khoa, bác sĩ</h3><p>Xem chuyên khoa và lựa chọn bác sĩ có ca trực đang diễn ra.</p></article>
                <article class="step"><span class="step-num">04</span><h3>Nhận số thứ tự</h3><p>Nhấn “Lấy số khám” và xem phiếu khám của mình ngay sau đó.</p></article>
            </div>
        </section>

        <section class="section" id="tien-ich">
            <span class="section-kicker">Dành cho bệnh nhân</span>
            <h2>Những tiện ích nổi bật</h2>
            <div class="features">
                <article class="feature"><span class="feature-icon" aria-hidden="true">✓</span><div><h3>Bác sĩ theo ca trực</h3><p>Danh sách bác sĩ được lọc theo lịch trực hiện tại trong hệ thống.</p></div></article>
                <article class="feature"><span class="feature-icon" aria-hidden="true">#</span><div><h3>Số khám rõ ràng</h3><p>Phiếu hiển thị số thứ tự, chuyên khoa, bác sĩ và trạng thái lượt khám.</p></div></article>
                <article class="feature"><span class="feature-icon" aria-hidden="true">＋</span><div><h3>Thao tác đơn giản</h3><p>Giao diện dễ sử dụng trên cả máy tính và điện thoại.</p></div></article>
            </div>
        </section>

        <section class="start-banner">
            <div>
                <h2>Sẵn sàng đăng ký khám?</h2>
                <p>Bắt đầu từ hồ sơ bệnh nhân, sau đó nhập BHYT và lựa chọn bác sĩ.</p>
            </div>
            <a class="small-btn" href="@duongDanBatDau">Đăng ký khám ngay →</a>
        </section>
    </main>

    <footer class="site-footer">
        <div class="wrap">© @DateTime.Now.Year eHealthCare · Website minh họa phục vụ đồ án. Thông tin BHYT chưa được xác thực trực tuyến.</div>
    </footer>
</body>
</html>
