
@using System

@{
    ViewBag.Title = "Phiếu số khám bệnh";
    Layout = null;

    int soThuTu = Convert.ToInt32(ViewBag.SoThuTu);
    string ngayKham =
        Convert.ToDateTime(ViewBag.NgayKham)
        .ToString("dd/MM/yyyy");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Phiếu số khám - eHealthCare</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef5fa;
            font-family: Arial, sans-serif;
            color: #344054;
        }

        .header {
            background: #087a9b;
            color: white;
            text-align: center;
            padding: 25px;
        }

            .header h1 {
                margin: 0;
                font-size: 30px;
            }

        .ticket {
            width: 92%;
            max-width: 520px;
            background: white;
            margin: 40px auto;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

            .ticket h2 {
                text-align: center;
                color: #087a9b;
                font-size: 23px;
            }

        .description {
            text-align: center;
            color: #667788;
            font-size: 14px;
        }

        .number-box {
            background: #e8f6fb;
            border-radius: 12px;
            padding: 25px;
            margin: 25px 0;
            text-align: center;
        }

        .number-label {
            color: #087a9b;
            font-weight: bold;
        }

        .number {
            font-size: 75px;
            font-weight: 800;
            color: #087a9b;
            margin: 10px 0;
        }

        .status {
            display: inline-block;
            background: #fff2d5;
            color: #946000;
            border-radius: 20px;
            padding: 8px 18px;
            font-size: 14px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            border-bottom: 1px solid #e8edf2;
            padding: 15px 0;
        }

            .info-row span {
                color: #667788;
            }

            .info-row strong {
                text-align: right;
            }

        .note {
            color: #667788;
            text-align: center;
            font-size: 13px;
            margin: 25px 0;
            line-height: 1.7;
        }

        .btn {
            width: 100%;
            display: block;
            box-sizing: border-box;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #087a9b;
            color: white;
            text-align: center;
            text-decoration: none;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 12px;
        }

        .btn-back {
            background: #e6f2f7;
            color: #087a9b;
        }

        @@media print {
            .header, .no-print {
                display: none;
            }

            body {
                background: white;
            }

            .ticket {
                box-shadow: none;
                margin: 0 auto;
            }
        }

        @@media (max-width: 480px) {
            .ticket {
                padding: 22px;
            }

            .number {
                font-size: 60px;
            }
        }
    </style>
</head>

<body>

    <header class="header">
        <h1>✚ eHealthCare</h1>
        <p>Hệ thống đăng ký khám bệnh trực tuyến</p>
    </header>

    <main class="ticket">

        <h2>PHIẾU SỐ THỨ TỰ KHÁM BỆNH</h2>

        <p class="description">
            Bạn đã nhận được số thứ tự khám bệnh.
        </p>

        <div class="number-box">
            <div class="number-label">
                SỐ THỨ TỰ CỦA BẠN
            </div>

            <div class="number">
                @soThuTu.ToString("D3")
            </div>

            <div class="status">
                @ViewBag.TrangThai
            </div>
        </div>

        <div class="info-row">
            <span>Mã lượt khám</span>
            <strong>@ViewBag.MaLuot</strong>
        </div>

        <div class="info-row">
            <span>Họ tên bệnh nhân</span>
            <strong>@ViewBag.TenBenhNhan</strong>
        </div>

        <div class="info-row">
            <span>Chuyên khoa</span>
            <strong>@ViewBag.TenKhoa</strong>
        </div>

        <div class="info-row">
            <span>Bác sĩ khám</span>
            <strong>@ViewBag.TenBacSi</strong>
        </div>

        <div class="info-row">
            <span>Ca trực</span>
            <strong>@ViewBag.TenCa</strong>
        </div>

        <div class="info-row">
            <span>Ngày khám</span>
            <strong>@ngayKham</strong>
        </div>

        <p class="note">
            Vui lòng giữ phiếu số này
            và theo dõi hướng dẫn gọi số tại khu vực khám bệnh.
        </p>

        <div class="no-print">

            <button type="button"
                    class="btn"
                    onclick="window.print()">
                In phiếu khám
            </button>

            <a class="btn btn-back"
               href="@Url.Action("Index", "Home")">
                Về trang chủ
            </a>

        </div>

    </main>

</body>
</html>
