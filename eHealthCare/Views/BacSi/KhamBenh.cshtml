@model eHealthCare.Controllers.KhamBenhViewModel
@using System

@{
    ViewBag.Title = "Bác sĩ ghi chẩn đoán";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phiếu khám - eHealthCare</title>
    <style>
        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            font-family: Arial,sans-serif;
            background: #f1f6f8;
            color: #263e51
        }

        header {
            padding: 23px 6%;
            background: #087a9b;
            color: white
        }

            header h1 {
                margin: 0;
                font-size: 25px
            }

            header p {
                margin: 6px 0 0;
                font-size: 13px
            }

        main {
            max-width: 820px;
            width: 94%;
            margin: 30px auto
        }

        .card {
            background: #fff;
            padding: 28px;
            border-radius: 14px;
            box-shadow: 0 3px 18px rgba(0,0,0,.06)
        }

        h2 {
            color: #087a9b;
            margin: 0 0 18px;
            font-size: 25px
        }

        .info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 25px
        }

            .info div {
                background: #f3f8fb;
                border-radius: 9px;
                padding: 12px
            }

            .info small {
                display: block;
                color: #617888;
                margin-bottom: 6px
            }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 10px
        }

        textarea {
            width: 100%;
            min-height: 170px;
            border: 1px solid #c8d8e0;
            border-radius: 9px;
            padding: 13px;
            font: 15px Arial,sans-serif;
            line-height: 1.55;
            resize: vertical
        }

        .hint {
            color: #687d8b;
            font-size: 13px;
            margin: 10px 0 20px
        }

        .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center
        }

        .btn {
            border: 0;
            background: #087a9b;
            color: white;
            border-radius: 8px;
            padding: 13px 22px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px
        }

        .back {
            background: #e6f2f7;
            color: #087a9b
        }

        .success {
            background: #e4f8ec;
            color: #17663b;
            padding: 13px;
            border-radius: 8px;
            margin-bottom: 16px
        }

        .error {
            background: #fff0ef;
            color: #aa2d2d;
            padding: 13px;
            border-radius: 8px;
            margin-bottom: 16px
        }

        @@media(max-width:650px) {
            .info {
                grid-template-columns: 1fr
            }

            .card {
                padding: 18px
            }
        }
    </style>
</head>
<body>
    <header>
        <h1>✚ eHealthCare</h1>
        <p>Trang bác sĩ — Ghi chẩn đoán bệnh nhân</p>
    </header>
    <main>
        <section class="card">
            <h2>PHIẾU KHÁM BỆNH</h2>
            <div class="info">
                <div><small>Số thứ tự</small><strong>@Model.SoThuTu.ToString("D3")</strong></div>
                <div><small>Mã lượt khám</small><strong>@Model.MaLuot</strong></div>
                <div><small>Bệnh nhân</small><strong>@Model.TenBenhNhan</strong></div>
                <div><small>Ngày khám</small><strong>@Model.NgayKham.ToString("dd/MM/yyyy")</strong></div>
                <div><small>Bác sĩ phụ trách</small><strong>@Model.TenBacSi</strong></div>
                <div><small>Chuyên khoa</small><strong>@Model.TenKhoa</strong></div>
            </div>

            @if (TempData["ThongBaoKham"] != null)
            {
                <div class="success">@TempData["ThongBaoKham"]</div>
            }
            @if (TempData["LoiKham"] != null)
            {
                <div class="error">@TempData["LoiKham"]</div>
            }

            <form method="post" action="@Url.Action("LuuChanDoan", "BacSi")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maLuot" value="@Model.MaLuot" />
                <label for="benhChanDoan">Chẩn đoán của bác sĩ *</label>
                <textarea id="benhChanDoan" name="benhChanDoan" maxlength="500"
                          required placeholder="Nhập chẩn đoán sau khi thăm khám...">@Model.BenhChanDoan</textarea>
                <p class="hint">Tối đa 500 ký tự, lưu vào cột PHIEU_KHAM.benh_chan_doan. Chưa kết thúc lượt khám ở bước này.</p>

                <div class="actions">
                    <button type="submit" class="btn">
                        Lưu chẩn đoán
                    </button>

                    <a class="btn back"
                       href="@Url.Action("DanhSachCho", "BacSi",
           new { ma_bs = Model.MaBacSi })">
                        Quay lại danh sách
                    </a>
                </div>
            </form>

            <!-- NÚT KÊ ĐƠN THUỐC -->
            <div class="actions"
                 style="margin-top:20px;
            padding-top:20px;
            border-top:1px solid #e5edf2;">

                <a class="btn"
                   href="@Url.Action("KeDon", "DonThuoc",
           new { id = Model.MaLuot })">
                    💊 Kê đơn thuốc
                </a>

            </div>


            <!-- HOÀN TẤT KHÁM BỆNH -->
            <div style="margin-top:20px;
            padding-top:20px;
            border-top:1px solid #e5edf2;">

                <form method="post"
                      action="@Url.Action("HoanTatKham", "BacSi")">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="maLuot"
                           value="@Model.MaLuot" />

                    <input type="hidden"
                           name="maBacSi"
                           value="@Model.MaBacSi" />

                    <button type="submit"
                            class="btn"
                            style="background:#178354;"
                            onclick="return confirm(
                    'Xác nhận hoàn tất khám bệnh?');">
                        ✓ Hoàn tất khám bệnh
                    </button>
                </form>
            </div>

        </section>
    </main>
</body>
</html>
